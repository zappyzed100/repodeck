import { ComboBox, ScrollView } from "std-widgets.slint";
import { GlassButton, GlassCheckbox, Theme } from "theme.slint";
import { LayoutStudio } from "layout-studio.slint";
export { LayoutStudio }
import { WorksetManager } from "workset-dialog.slint";
export { WorksetManager }
import { QuickSwitcher } from "quick-switcher.slint";
export { QuickSwitcher }

component SectionLabel inherits Text {
    font-family: Theme.font-text;
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-secondary;
    letter-spacing: 0.3px;
}

// Repurposed from a plain "RepoDeck is running" placeholder into the
// settings surface (PLAN.md §13 Phase 7 checklist item 4, "ホットキー設定
// UI"): once the tray's left-click and the second-instance signal both show
// the Quick Switcher instead, this window had nothing left pointing at it.
export component AppWindow inherits Window {
    title: "RepoDeck — 設定";
    icon: @image-url("../assets/repodeck-icon.svg");
    preferred-width: 420px;
    preferred-height: 860px;
    background: transparent;
    default-font-family: Theme.font-text;

    in-out property <bool> hotkey-ctrl: true;
    in-out property <bool> hotkey-alt: true;
    in-out property <bool> hotkey-shift: false;
    in-out property <bool> hotkey-win: false;
    in property <[string]> hotkey-key-choices: [];
    in-out property <string> hotkey-key-choice: "R";
    // Kept in sync with `hotkey-key-choice` from Rust: `ComboBox`'s own
    // `current-value: root.model[root.current-index]` default binding on
    // `current-index` otherwise keeps winning over a plain `set_hotkey_key_choice(...)`
    // call from the Rust side, visually showing `model[0]` instead of the
    // value that was just set.
    in-out property <int> hotkey-key-index: 0;
    in property <string> hotkey-status-text: "";
    in property <bool> hotkey-status-is-warning: false;

    // Codex連携 (PLAN.md §6.5, Phase 8).
    in property <bool> codex-hook-exe-found: false;
    in property <string> codex-hook-snippet: "";
    in property <string> codex-status-text: "";
    in property <bool> codex-status-is-warning: false;
    in property <bool> codex-send-test-event-enabled: false;

    // バージョン情報 (Phase 9).
    in property <string> app-version: "";

    // 起動設定 (Phase 9).
    in-out property <bool> start-with-windows: false;
    in property <string> autostart-status-text: "";
    in property <bool> autostart-status-is-warning: false;

    callback hotkey-rebind-requested();
    callback open-layout-studio-requested();
    callback open-workset-manager-requested();
    callback codex-check-hook-exe-requested();
    callback codex-copy-snippet-requested();
    callback codex-open-config-folder-requested();
    callback codex-send-test-event-requested();
    callback open-third-party-notices-requested();
    callback start-with-windows-toggled(bool);

    Rectangle {
        // The glass card: everything visible sits on this opaque layer, so
        // text stays legible whether or not the OS is compositing a real
        // blur behind the (transparent) window (see Theme.glass-base).
        background: Theme.glass-base;
        border-width: 1px;
        border-color: Theme.hairline-bright;

        VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            HorizontalLayout {
                alignment: center;
                spacing: Theme.space-sm;

                Image {
                    source: @image-url("../assets/repodeck-icon.svg");
                    width: 32px;
                    height: 32px;
                }

                Text {
                    text: "RepoDeck 設定";
                    font-family: Theme.font-display;
                    font-size: 22px;
                    font-weight: 600;
                    letter-spacing: -0.3px;
                    color: Theme.text-primary;
                }
            }

            SectionLabel { text: "クイックスイッチャーのホットキー"; }

            HorizontalLayout {
                spacing: Theme.space-sm;

                HorizontalLayout {
                    spacing: 4px;
                    GlassCheckbox {
                        checked: root.hotkey-ctrl;
                        toggled => { root.hotkey-ctrl = !root.hotkey-ctrl; }
                    }
                    Text { text: "Ctrl"; vertical-alignment: center; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    GlassCheckbox {
                        checked: root.hotkey-alt;
                        toggled => { root.hotkey-alt = !root.hotkey-alt; }
                    }
                    Text { text: "Alt"; vertical-alignment: center; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    GlassCheckbox {
                        checked: root.hotkey-shift;
                        toggled => { root.hotkey-shift = !root.hotkey-shift; }
                    }
                    Text { text: "Shift"; vertical-alignment: center; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    spacing: 4px;
                    GlassCheckbox {
                        checked: root.hotkey-win;
                        toggled => { root.hotkey-win = !root.hotkey-win; }
                    }
                    Text { text: "Win"; vertical-alignment: center; color: Theme.text-secondary; }
                }

                ComboBox {
                    model: root.hotkey-key-choices;
                    current-value <=> root.hotkey-key-choice;
                    current-index <=> root.hotkey-key-index;
                }
            }

            GlassButton {
                text: "ホットキーを保存";
                primary: true;
                clicked => { root.hotkey-rebind-requested(); }
            }

            if root.hotkey-status-text != "": Text {
                text: root.hotkey-status-text;
                font-size: 12px;
                color: root.hotkey-status-is-warning ? Theme.danger : Theme.success;
                wrap: word-wrap;
            }

            Rectangle { height: Theme.space-sm; }

            GlassButton {
                text: "レイアウトスタジオを開く";
                clicked => { root.open-layout-studio-requested(); }
            }

            GlassButton {
                text: "セット管理を開く";
                clicked => { root.open-workset-manager-requested(); }
            }

            Rectangle { height: Theme.space-sm; }

            SectionLabel { text: "Codex連携"; }

            Text {
                text: root.codex-hook-exe-found ? "hook実行ファイル: 検出済み" : "hook実行ファイル: 未検出";
                font-size: 12px;
                color: root.codex-hook-exe-found ? Theme.text-secondary : Theme.danger;
            }

            GlassButton {
                text: "hook実行ファイルを確認";
                clicked => { root.codex-check-hook-exe-requested(); }
            }

            GlassButton {
                text: "hooks.json断片をコピー";
                clicked => { root.codex-copy-snippet-requested(); }
            }

            if root.codex-hook-snippet != "": Rectangle {
                height: 100px;
                border-radius: Theme.radius-md;
                background: Theme.glass-panel-soft;
                border-width: 1px;
                border-color: Theme.hairline;

                ScrollView {
                    Text {
                        text: root.codex-hook-snippet;
                        font-size: 10px;
                        font-family: "Consolas";
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            GlassButton {
                text: "Codex設定フォルダーを開く";
                clicked => { root.codex-open-config-folder-requested(); }
            }

            GlassButton {
                text: "テストイベントを送信";
                enabled: root.codex-send-test-event-enabled;
                clicked => { root.codex-send-test-event-requested(); }
            }

            if root.codex-status-text != "": Text {
                text: root.codex-status-text;
                font-size: 12px;
                color: root.codex-status-is-warning ? Theme.danger : Theme.success;
                wrap: word-wrap;
            }

            Text {
                text: "Codex CLIの /hooks で4つのフックを信頼するまで、イベントは届きません。";
                font-size: 11px;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }

            Rectangle { height: Theme.space-sm; }

            SectionLabel { text: "起動設定"; }

            HorizontalLayout {
                spacing: 4px;
                GlassCheckbox {
                    checked: root.start-with-windows;
                    toggled => {
                        root.start-with-windows = !root.start-with-windows;
                        root.start-with-windows-toggled(root.start-with-windows);
                    }
                }
                Text {
                    text: "Windows起動時にRepoDeckを自動起動する";
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            if root.autostart-status-text != "": Text {
                text: root.autostart-status-text;
                font-size: 12px;
                color: root.autostart-status-is-warning ? Theme.danger : Theme.success;
                wrap: word-wrap;
            }

            Rectangle { height: Theme.space-sm; }

            SectionLabel { text: "バージョン情報"; }

            Text {
                text: "RepoDeck " + root.app-version;
                font-size: 12px;
                color: Theme.text-secondary;
            }

            Text {
                text: "UIは Slint (https://slint.rs) で構築されています。Slint Royalty-free Desktop Licenseの下で利用しており、Slint自体は再配布していません。";
                font-size: 11px;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }

            GlassButton {
                text: "サードパーティ表示";
                clicked => { root.open-third-party-notices-requested(); }
            }
        }
    }
}

export component TrayIcon inherits SystemTrayIcon {
    // `icon`/`tooltip` are inherited builtin properties of `SystemTrayIcon`,
    // not properties declared on this component — Slint only generates
    // Rust setters for properties declared at the component's own level, so
    // runtime tray-icon-color updates (PLAN.md §6.7, Phase 8) alias them
    // through component-level properties instead of setting `icon`/
    // `tooltip` directly.
    in-out property <image> icon-source <=> root.icon;
    in-out property <string> tooltip-text <=> root.tooltip;
    icon: @image-url("../assets/repodeck-icon.svg");
    tooltip: "RepoDeck";

    Menu {
        MenuItem {
            title: "クイックスイッチャーを開く";
            activated => { root.quick-switcher-requested(); }
        }

        MenuItem {
            title: "レイアウトスタジオを開く";
            activated => { root.layout-studio-requested(); }
        }

        MenuItem {
            title: "新しいセットを登録";
            activated => { root.register-workset-requested(); }
        }

        MenuItem {
            title: "メイン画面を空にする";
            activated => { root.empty-main-screen-requested(); }
        }

        MenuItem {
            title: "全管理ウィンドウを回収";
            activated => { root.recover-all-requested(); }
        }

        MenuSeparator { }

        MenuItem {
            title: "設定";
            activated => { root.settings-requested(); }
        }

        MenuItem {
            title: "ログフォルダーを開く";
            activated => { root.open-log-folder-requested(); }
        }

        MenuSeparator { }

        MenuItem {
            title: "RepoDeckを終了";
            activated => { root.quit-requested(); }
        }
    }

    callback toggle-quick-switcher-requested();
    callback quick-switcher-requested();
    callback layout-studio-requested();
    callback register-workset-requested();
    callback empty-main-screen-requested();
    callback recover-all-requested();
    callback settings-requested();
    callback open-log-folder-requested();
    callback quit-requested();

    // Left-click on the tray icon toggles the Quick Switcher's visibility
    // (PLAN.md §3.4); a menu click on "クイックスイッチャーを開く" always
    // shows it (fresh position, never closes an already-open one) — those
    // are deliberately different callbacks with different semantics.
    clicked => { root.toggle-quick-switcher-requested(); }
}
