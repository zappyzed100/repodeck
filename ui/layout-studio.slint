import { ScrollView, LineEdit } from "std-widgets.slint";
import { GlassButton, GlassCheckbox, Theme } from "theme.slint";

export struct MonitorTile {
    x: length,
    y: length,
    width: length,
    height: length,
    device-name: string,
    detail-label: string,
    role-label: string,
    is-main: bool,
    is-sub: bool,
    is-excluded: bool,
    selected: bool,
}

export struct SubScreenRow {
    name: string,
    // Whether the currently-selected monitor is assigned to this sub-screen.
    assigned: bool,
}

export struct MainScreenCandidate {
    title: string,
    process-name: string,
    checked: bool,
}

component GlassPanel inherits Rectangle {
    background: Theme.glass-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.hairline;
}

component SectionLabel inherits Text {
    font-family: Theme.font-text;
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-secondary;
    letter-spacing: 0.3px;
}

export component LayoutStudio inherits Window {
    title: "RepoDeck — レイアウトスタジオ";
    icon: @image-url("../assets/repodeck-icon.svg");
    // A *preferred* (not fixed) size: unlike workset-dialog.slint, every
    // branch that used to change this window's natural content size (the
    // "メインを空にする" confirmation panel, the auto-split box below) has
    // been pulled out of the layout flow — as a floating overlay and a
    // fixed-height reservation respectively — so nothing left changes the
    // preferred size at runtime. Leaving this as a preferred size (rather
    // than a fixed one) matters: a fixed size makes Slint ignore the OS
    // window's real size after a user resize/maximize, so `canvas-frame`
    // below (and everything else) stays pinned at 1000x680 in a corner of
    // the larger OS window instead of actually filling it.
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 640px;
    background: transparent;
    default-font-family: Theme.font-text;

    in property <[MonitorTile]> monitor-tiles: [];
    in property <int> selected-monitor-index: -1;
    in property <string> selected-monitor-detail: "モニターを選択してください";
    in property <bool> selected-is-main: false;
    in property <bool> selected-excluded: false;
    in property <bool> selected-has-monitor: false;
    // 0 = 自動 (the app picks from the monitor's work area); 1/2/4 = manual.
    in property <int> selected-auto-split: 0;

    in property <string> status-text: "";
    in property <bool> status-is-warning: false;
    in property <bool> undo-available: false;

    in property <bool> empty-screen-panel-visible: false;
    in property <[MainScreenCandidate]> main-screen-candidates: [];

    in property <[SubScreenRow]> sub-screen-rows: [];

    callback refresh-requested();
    callback sub-screen-add(name: string);
    callback sub-screen-delete(index: int);
    callback sub-screen-toggle-monitor(index: int);
    callback monitor-clicked(index: int);
    callback toggle-main-requested();
    callback toggle-excluded-requested();
    callback set-auto-split(monitor-index: int, split: int);
    callback empty-main-screen-requested();
    callback candidate-toggled(index: int);
    callback confirm-empty-main-screen();
    callback cancel-empty-main-screen();
    callback undo-requested();
    callback save-requested();
    // Fires whenever the canvas card's actual on-screen size changes (first
    // layout pass, or a window resize), so Rust can project monitor tiles
    // onto the card's real bounds instead of a guessed constant.
    callback canvas-resized(width: length, height: length);

    backdrop := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.glass-base;
        border-width: 1px;
        border-color: Theme.hairline-bright;
    }

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        // --- Toolbar ---
        HorizontalLayout {
            spacing: Theme.space-xs;
            height: 36px;

            GlassButton {
                text: "モニター一覧を更新";
                clicked => { root.refresh-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
            GlassButton {
                text: "設定を保存";
                primary: true;
                clicked => { root.save-requested(); }
            }
        }

        // --- Main content: canvas + right pane ---
        HorizontalLayout {
            spacing: Theme.space-sm;

            // Monitor canvas
            canvas-frame := GlassPanel {
                horizontal-stretch: 1;

                changed width => { root.canvas-resized(self.width, self.height); }
                changed height => { root.canvas-resized(self.width, self.height); }

                for tile[i] in root.monitor-tiles: Rectangle {
                    x: tile.x;
                    y: tile.y;
                    width: tile.width;
                    height: tile.height;
                    // Clip so a small tile's labels can't spill over neighbouring
                    // tiles (with many monitors the projected tiles get small).
                    clip: true;
                    background: tile.selected ? Theme.glass-selected : (tile.is-main ? Theme.accent-soft : Theme.glass-panel-soft);
                    border-width: tile.selected ? 2px : 1px;
                    border-color: tile.is-main ? Theme.accent : (tile.is-sub ? Theme.warning : Theme.hairline-bright);
                    border-radius: Theme.radius-sm;
                    opacity: tile.is-excluded ? 0.45 : 1.0;
                    animate background, border-color, opacity { duration: Theme.duration-base; easing: ease-out; }

                    VerticalLayout {
                        padding: Theme.space-xs;
                        alignment: start;
                        Text {
                            text: tile.role-label;
                            font-size: 12px;
                            font-weight: 700;
                            color: tile.is-main ? Theme.accent : (tile.is-sub ? Theme.warning : (tile.is-excluded ? Theme.text-tertiary : Theme.text-primary));
                        }
                        Text {
                            text: tile.device-name;
                            font-size: 11px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: tile.detail-label;
                            font-size: 10px;
                            color: Theme.text-tertiary;
                        }
                    }

                    TouchArea {
                        clicked => { root.monitor-clicked(i); }
                    }
                }
            }

            // Right property pane
            GlassPanel {
                width: 260px;

                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    alignment: start;

                    SectionLabel { text: "プロパティ"; }
                    Text {
                        text: root.selected-monitor-detail;
                        font-size: 12px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    // Always reserves this height, whether or not the per-monitor
                    // controls are showing: letting this row's natural height
                    // change with `selected-has-monitor`/`selected-is-main` would
                    // feed back into the window's preferred size (now that it's
                    // `preferred-width`/`preferred-height`, not a fixed size —
                    // see the comment on `LayoutStudio` above), so the window
                    // would visibly resize every time the selection changes.
                    Rectangle {
                        height: 460px;
                        if root.selected-has-monitor: VerticalLayout {
                            spacing: Theme.space-sm;
                            alignment: start;

                            GlassButton {
                                text: root.selected-is-main ? "メイン画面から外す" : "メイン画面に登録する";
                                primary: !root.selected-is-main && !root.selected-excluded;
                                enabled: !root.selected-excluded;
                                clicked => { root.toggle-main-requested(); }
                            }

                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                GlassCheckbox {
                                    checked: root.selected-excluded;
                                    enabled: !root.selected-is-main;
                                    toggled => { root.toggle-excluded-requested(); }
                                }
                                Text {
                                    text: "RepoDeckの操作対象にしない";
                                    font-size: 12px;
                                    color: root.selected-is-main ? Theme.text-tertiary : Theme.text-secondary;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            if !root.selected-is-main && !root.selected-excluded: VerticalLayout {
                                spacing: Theme.space-xs;
                                SectionLabel { text: "自動分割"; }
                                HorizontalLayout {
                                    spacing: Theme.space-xs;
                                    GlassButton {
                                        text: "自動";
                                        primary: root.selected-auto-split == 0;
                                        clicked => { root.set-auto-split(root.selected-monitor-index, 0); }
                                    }
                                    GlassButton {
                                        text: "1";
                                        primary: root.selected-auto-split == 1;
                                        clicked => { root.set-auto-split(root.selected-monitor-index, 1); }
                                    }
                                    GlassButton {
                                        text: "2";
                                        primary: root.selected-auto-split == 2;
                                        clicked => { root.set-auto-split(root.selected-monitor-index, 2); }
                                    }
                                    GlassButton {
                                        text: "4";
                                        primary: root.selected-auto-split == 4;
                                        clicked => { root.set-auto-split(root.selected-monitor-index, 4); }
                                    }
                                }
                                Text {
                                    text: "「自動」は解像度から分割数を決めます。";
                                    font-size: 10px;
                                    color: Theme.text-tertiary;
                                    wrap: word-wrap;
                                }
                            }

                            // --- Sub-screen (退避先) management ---
                            Rectangle { height: 1px; background: Theme.hairline; }
                            SectionLabel { text: "サブ画面（退避先エリア）"; }
                            Text {
                                text: "このモニターを割り当てるサブ画面を選択。1つのサブ画面に複数モニターも可。";
                                font-size: 10px;
                                color: Theme.text-tertiary;
                                wrap: word-wrap;
                            }
                            ScrollView {
                                height: 120px;
                                VerticalLayout {
                                    spacing: 2px;
                                    for sub[i] in root.sub-screen-rows: HorizontalLayout {
                                        spacing: Theme.space-xs;
                                        height: 28px;
                                        GlassCheckbox {
                                            checked: sub.assigned;
                                            enabled: !root.selected-is-main && !root.selected-excluded;
                                            toggled => { root.sub-screen-toggle-monitor(i); }
                                        }
                                        Text {
                                            text: sub.name;
                                            font-size: 12px;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        GlassButton {
                                            text: "削除";
                                            clicked => { root.sub-screen-delete(i); }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                new-sub-name := LineEdit {
                                    placeholder-text: "新しいサブ画面名";
                                    horizontal-stretch: 1;
                                }
                                GlassButton {
                                    text: "追加";
                                    clicked => {
                                        root.sub-screen-add(new-sub-name.text);
                                        new-sub-name.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Status bar ---
        Text {
            text: root.status-text;
            font-size: 12px;
            color: root.status-is-warning ? Theme.danger : Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    // --- "メインを空にする" confirmation modal ---
    // A floating overlay rather than a row in the main VerticalLayout: inserting
    // it into that flow stole height from the monitor canvas above, and since
    // the canvas's monitor tiles are positioned in fixed logical pixels (sized
    // for the full canvas — see `CANVAS_WIDTH`/`CANVAS_HEIGHT` in app.rs), a
    // shrunk canvas made the lower tiles overflow past the frame and render
    // underneath this panel. Floating it leaves the canvas untouched.
    if root.empty-screen-panel-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: rgba(0, 0, 0, 0.55);

        TouchArea { }

        GlassPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 360px;

            VerticalLayout {
                padding: Theme.space-md;
                spacing: Theme.space-sm;

                Text {
                    text: "メイン画面上の未登録ウィンドウ — 最小化するものにチェックしてください";
                    font-size: 13px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for candidate[i] in root.main-screen-candidates: HorizontalLayout {
                            spacing: Theme.space-xs;
                            height: 26px;
                            GlassCheckbox {
                                checked: candidate.checked;
                                toggled => { root.candidate-toggled(i); }
                            }
                            Text {
                                text: candidate.title + "  (" + candidate.process-name + ")";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Rectangle { horizontal-stretch: 1; }
                    GlassButton {
                        text: "キャンセル";
                        clicked => { root.cancel-empty-main-screen(); }
                    }
                    GlassButton {
                        text: "確定して最小化";
                        primary: true;
                        clicked => { root.confirm-empty-main-screen(); }
                    }
                }
            }
        }
    }
}
