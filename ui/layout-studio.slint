import { ScrollView } from "std-widgets.slint";
import { GlassButton, GlassCheckbox, Theme } from "theme.slint";

export struct MonitorTile {
    x: length,
    y: length,
    width: length,
    height: length,
    device-name: string,
    detail-label: string,
    role-label: string,
    is-main: bool,
    selected: bool,
}

export struct MainScreenCandidate {
    title: string,
    process-name: string,
    checked: bool,
}

component GlassPanel inherits Rectangle {
    background: Theme.glass-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.hairline;
}

component SectionLabel inherits Text {
    font-family: Theme.font-text;
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-secondary;
    letter-spacing: 0.3px;
}

export component LayoutStudio inherits Window {
    title: "RepoDeck — レイアウトスタジオ";
    icon: @image-url("../assets/repodeck-icon.svg");
    // Fixed (not just preferred) size: showing/hiding the "メインを空にする"
    // confirmation panel changes the layout tree's natural content width, and
    // Slint would otherwise shrink the whole OS window to fit whichever
    // branch is narrower (see the same fix in workset-dialog.slint).
    width: 1000px;
    height: 680px;
    background: transparent;
    default-font-family: Theme.font-text;

    in property <[MonitorTile]> monitor-tiles: [];
    in property <bool> selecting-main: false;
    in property <int> selected-monitor-index: -1;
    in property <string> selected-monitor-detail: "モニターを選択してください";
    in property <bool> selected-is-main: false;
    in property <bool> selected-has-monitor: false;
    in property <int> selected-auto-split: 1;

    in property <string> status-text: "";
    in property <bool> status-is-warning: false;
    in property <bool> undo-available: false;

    in property <bool> empty-screen-panel-visible: false;
    in property <[MainScreenCandidate]> main-screen-candidates: [];

    callback refresh-requested();
    callback toggle-select-main-mode();
    callback monitor-clicked(index: int);
    callback apply-main-selection();
    callback set-auto-split(monitor-index: int, split: int);
    callback empty-main-screen-requested();
    callback candidate-toggled(index: int);
    callback confirm-empty-main-screen();
    callback cancel-empty-main-screen();
    callback undo-requested();
    callback save-requested();

    backdrop := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.glass-base;
        border-width: 1px;
        border-color: Theme.hairline-bright;
    }

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        // --- Toolbar ---
        HorizontalLayout {
            spacing: Theme.space-xs;
            height: 36px;

            GlassButton {
                text: root.selecting-main ? "選択モードを終了" : "メイン画面を選択";
                clicked => { root.toggle-select-main-mode(); }
            }
            GlassButton {
                text: "選択を適用";
                primary: root.selecting-main;
                enabled: root.selecting-main;
                clicked => { root.apply-main-selection(); }
            }
            GlassButton {
                text: "モニター一覧を更新";
                clicked => { root.refresh-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
            GlassButton {
                text: "メイン画面を空にする";
                clicked => { root.empty-main-screen-requested(); }
            }
            GlassButton {
                text: "元に戻す";
                enabled: root.undo-available;
                clicked => { root.undo-requested(); }
            }
            GlassButton {
                text: "設定を保存";
                primary: true;
                clicked => { root.save-requested(); }
            }
        }

        // --- Main content: canvas + right pane ---
        HorizontalLayout {
            spacing: Theme.space-sm;

            // Monitor canvas
            canvas-frame := GlassPanel {
                horizontal-stretch: 1;

                for tile[i] in root.monitor-tiles: Rectangle {
                    x: tile.x;
                    y: tile.y;
                    width: tile.width;
                    height: tile.height;
                    background: tile.selected ? Theme.glass-selected : (tile.is-main ? Theme.accent-soft : Theme.glass-panel-soft);
                    border-width: tile.selected ? 2px : 1px;
                    border-color: tile.is-main ? Theme.accent : Theme.hairline-bright;
                    border-radius: Theme.radius-sm;
                    animate background, border-color { duration: Theme.duration-base; easing: ease-out; }

                    VerticalLayout {
                        padding: Theme.space-xs;
                        alignment: start;
                        Text {
                            text: tile.role-label;
                            font-size: 12px;
                            font-weight: 700;
                            color: tile.is-main ? Theme.accent : Theme.text-primary;
                        }
                        Text {
                            text: tile.device-name;
                            font-size: 11px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                        Text {
                            text: tile.detail-label;
                            font-size: 10px;
                            color: Theme.text-tertiary;
                        }
                    }

                    TouchArea {
                        clicked => { root.monitor-clicked(i); }
                    }
                }
            }

            // Right property pane
            GlassPanel {
                width: 260px;

                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;
                    alignment: start;

                    SectionLabel { text: "プロパティ"; }
                    Text {
                        text: root.selected-monitor-detail;
                        font-size: 12px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    if root.selected-has-monitor && !root.selected-is-main: Rectangle {
                        height: 100px;
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            SectionLabel { text: "自動分割"; }
                            HorizontalLayout {
                                spacing: Theme.space-xs;
                                GlassButton {
                                    text: "1分割";
                                    primary: root.selected-auto-split == 1;
                                    clicked => { root.set-auto-split(root.selected-monitor-index, 1); }
                                }
                                GlassButton {
                                    text: "2分割";
                                    primary: root.selected-auto-split == 2;
                                    clicked => { root.set-auto-split(root.selected-monitor-index, 2); }
                                }
                                GlassButton {
                                    text: "4分割";
                                    primary: root.selected-auto-split == 4;
                                    clicked => { root.set-auto-split(root.selected-monitor-index, 4); }
                                }
                            }
                            Text {
                                text: "固定枠の割当はワークセット登録後に利用できます。";
                                font-size: 10px;
                                color: Theme.text-tertiary;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        // --- Status bar ---
        Text {
            text: root.status-text;
            font-size: 12px;
            color: root.status-is-warning ? Theme.danger : Theme.text-tertiary;
            wrap: word-wrap;
        }
    }

    // --- "メインを空にする" confirmation modal ---
    // A floating overlay rather than a row in the main VerticalLayout: inserting
    // it into that flow stole height from the monitor canvas above, and since
    // the canvas's monitor tiles are positioned in fixed logical pixels (sized
    // for the full canvas — see `CANVAS_WIDTH`/`CANVAS_HEIGHT` in app.rs), a
    // shrunk canvas made the lower tiles overflow past the frame and render
    // underneath this panel. Floating it leaves the canvas untouched.
    if root.empty-screen-panel-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: rgba(0, 0, 0, 0.55);

        TouchArea { }

        GlassPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 360px;

            VerticalLayout {
                padding: Theme.space-md;
                spacing: Theme.space-sm;

                Text {
                    text: "メイン画面上の未登録ウィンドウ — 最小化するものにチェックしてください";
                    font-size: 13px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for candidate[i] in root.main-screen-candidates: HorizontalLayout {
                            spacing: Theme.space-xs;
                            height: 26px;
                            GlassCheckbox {
                                checked: candidate.checked;
                                toggled => { root.candidate-toggled(i); }
                            }
                            Text {
                                text: candidate.title + "  (" + candidate.process-name + ")";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Rectangle { horizontal-stretch: 1; }
                    GlassButton {
                        text: "キャンセル";
                        clicked => { root.cancel-empty-main-screen(); }
                    }
                    GlassButton {
                        text: "確定して最小化";
                        primary: true;
                        clicked => { root.confirm-empty-main-screen(); }
                    }
                }
            }
        }
    }
}
