import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct WorksetSummary {
    name: string,
    repository_path: string,
    window_count: int,
    color: color,
    status_label: string,
}

export struct ManagedWindowSummary {
    title: string,
    status_label: string,
    status_is_warning: bool,
}

export struct RegistrationCandidate {
    title: string,
    process_name: string,
    checked: bool,
}

export component WorksetManager inherits Window {
    title: "RepoDeck — セット管理";
    icon: @image-url("../assets/repodeck-icon.svg");
    // Fixed (not just preferred) size: switching between the list and
    // registration views showed different natural content widths, and Slint
    // would otherwise shrink the whole OS window to the narrower branch's
    // minimum size when it became active.
    width: 920px;
    height: 620px;

    in property <[WorksetSummary]> worksets: [];
    in property <int> selected-workset-index: -1;
    in property <[ManagedWindowSummary]> selected-workset-windows: [];

    in property <bool> registering: false;
    in property <string> picked-folder-label: "（未選択）";
    in property <string> resolved-repo-label: "";
    in property <[RegistrationCandidate]> candidates: [];
    in property <[color]> color-choices: [#2563eb, #16a34a, #d97706, #dc2626, #7c3aed, #0891b2];
    in property <color> selected-color: #2563eb;

    in property <string> status-text: "";
    in property <bool> status-is-warning: false;

    callback refresh-requested();
    callback workset-selected(index: int);
    callback delete-workset-requested();
    callback rebind-requested(window-index: int);

    callback start-registration();
    callback cancel-registration();
    callback pick-folder-requested();
    callback candidate-toggled(index: int);
    callback color-selected(color: color);
    callback register-requested(name: string);

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        if !root.registering: HorizontalLayout {
            spacing: 10px;

            // Left: workset list
            Rectangle {
                width: 300px;
                background: #12151d;
                border-radius: 8px;
                border-width: 1px;
                border-color: #232838;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "登録済みセット";
                            font-size: 13px;
                            font-weight: 700;
                            color: #e7ebf3;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "更新";
                            clicked => { root.refresh-requested(); }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 4px;
                            for w[i] in root.worksets: Rectangle {
                                height: 56px;
                                background: root.selected-workset-index == i ? #1d4ed8 : #1a1f2b;
                                border-radius: 6px;
                                border-width: 2px;
                                border-color: w.color;

                                VerticalLayout {
                                    padding: 6px;
                                    Text { text: w.name; font-size: 12px; font-weight: 700; color: white; }
                                    Text { text: w.repository_path; font-size: 10px; color: #94a3b8; wrap: no-wrap; overflow: elide; }
                                    Text { text: w.status_label; font-size: 10px; color: #cbd5e1; }
                                }

                                TouchArea { clicked => { root.workset-selected(i); } }
                            }
                        }
                    }

                    Button {
                        text: "+ 現在の配置をセットとして登録";
                        primary: true;
                        clicked => { root.start-registration(); }
                    }
                }
            }

            // Right: selected workset detail
            Rectangle {
                horizontal-stretch: 1;
                background: #12151d;
                border-radius: 8px;
                border-width: 1px;
                border-color: #232838;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "ウィンドウ一覧";
                            font-size: 13px;
                            font-weight: 700;
                            color: #e7ebf3;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "このセットを削除";
                            enabled: root.selected-workset-index >= 0;
                            clicked => { root.delete-workset-requested(); }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: 4px;
                            for w[i] in root.selected-workset-windows: Rectangle {
                                height: 44px;
                                background: #1a1f2b;
                                border-radius: 6px;

                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        Text { text: w.title; font-size: 12px; color: #e7ebf3; }
                                        Text {
                                            text: w.status_label;
                                            font-size: 10px;
                                            color: w.status_is_warning ? #f87171 : #4ade80;
                                        }
                                    }
                                    Button {
                                        text: "このウィンドウを再登録";
                                        clicked => { root.rebind-requested(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.registering: Rectangle {
            background: #12151d;
            border-radius: 8px;
            border-width: 1px;
            border-color: #232838;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                Text { text: "新しいワークセットを登録"; font-size: 15px; font-weight: 700; color: #e7ebf3; }

                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "リポジトリフォルダーを選択";
                        clicked => { root.pick-folder-requested(); }
                    }
                    Text { text: root.picked-folder-label; font-size: 12px; color: #cbd5e1; vertical-alignment: center; }
                }
                Text { text: root.resolved-repo-label; font-size: 11px; color: #94a3b8; wrap: word-wrap; }

                Text { text: "名前"; font-size: 12px; color: #e7ebf3; }
                name-input := LineEdit { placeholder-text: "ワークセット名"; }

                Text { text: "色"; font-size: 12px; color: #e7ebf3; }
                HorizontalLayout {
                    spacing: 6px;
                    for c in root.color-choices: Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: c;
                        border-width: root.selected-color == c ? 3px : 0px;
                        border-color: white;
                        TouchArea { clicked => { root.color-selected(c); } }
                    }
                }

                Text { text: "候補ウィンドウ（メイン画面上で検出）"; font-size: 12px; color: #e7ebf3; }
                ScrollView {
                    height: 160px;
                    VerticalLayout {
                        spacing: 2px;
                        for candidate[i] in root.candidates: HorizontalLayout {
                            spacing: 8px;
                            height: 24px;
                            CheckBox {
                                checked: candidate.checked;
                                toggled => { root.candidate-toggled(i); }
                            }
                            Text {
                                text: candidate.title + "  (" + candidate.process_name + ")";
                                font-size: 12px;
                                color: #cbd5e1;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "キャンセル";
                        clicked => { root.cancel-registration(); }
                    }
                    Button {
                        text: "登録";
                        primary: true;
                        clicked => { root.register-requested(name-input.text); }
                    }
                }
            }
        }

        Text {
            text: root.status-text;
            font-size: 12px;
            color: root.status-is-warning ? #f87171 : #94a3b8;
            wrap: word-wrap;
        }
    }
}
