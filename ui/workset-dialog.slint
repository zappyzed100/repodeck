import { LineEdit, ScrollView } from "std-widgets.slint";
import { GlassButton, GlassCheckbox, StatusBanner, Theme } from "theme.slint";

export struct WorksetSummary {
    name: string,
    repository_path: string,
    window_count: int,
    color: color,
    status_label: string,
    parking_label: string,
}

export struct ManagedWindowSummary {
    title: string,
    status_label: string,
    status_is_warning: bool,
}

export struct RegistrationCandidate {
    title: string,
    process_name: string,
    checked: bool,
}

component GlassPanel inherits Rectangle {
    background: Theme.glass-panel;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.hairline;
}

component SectionLabel inherits Text {
    font-family: Theme.font-text;
    font-size: 12px;
    font-weight: 600;
    color: Theme.text-secondary;
    letter-spacing: 0.3px;
}

export component WorksetManager inherits Window {
    title: "RepoDeck — セット管理";
    icon: @image-url("../assets/repodeck-icon.svg");
    // Fixed (not just preferred) size: switching between the list and
    // registration views showed different natural content widths, and Slint
    // would otherwise shrink the whole OS window to the narrower branch's
    // minimum size when it became active.
    width: 920px;
    height: 760px;
    background: transparent;
    default-font-family: Theme.font-text;

    in property <[WorksetSummary]> worksets: [];
    in property <int> selected-workset-index: -1;
    in property <[ManagedWindowSummary]> selected-workset-windows: [];

    in property <bool> registering: false;
    in property <string> picked-folder-label: "（未選択）";
    in property <string> resolved-repo-label: "";
    in property <[RegistrationCandidate]> candidates: [];
    in property <[color]> color-choices: [#0a84ff, #30d158, #ff9f0a, #ff453a, #bf5af2, #64d2ff];
    in property <color> selected-color: #0a84ff;
    in-out property <bool> fullscreen-when-parked: false;

    // 退避先: pick where this workset parks when it isn't current — 自動 or one
    // of the named sub-screens defined in Layout Studio.
    in property <[string]> parking-subs: [];
    in-out property <int> parking-selected-sub: -1;

    // When true the registration view is editing an existing set ("配置を
    // 再登録") rather than creating a new one; the name is pre-filled.
    in property <bool> registration-editing: false;
    in-out property <string> registration-name: "";

    in property <string> status-text: "";
    in property <bool> status-is-warning: false;

    // "メイン画面を空にする" (moved here from Layout Studio): minimize the
    // unregistered windows currently sitting on the main screen, so a clean
    // set can be captured.
    in property <bool> empty-screen-panel-visible: false;
    in property <[RegistrationCandidate]> main-screen-candidates: [];
    in property <bool> empty-undo-available: false;

    in property <int> selected-missing-count: 0;

    callback refresh-requested();
    callback workset-selected(index: int);
    callback delete-workset-requested();
    callback reopen-closed-requested();
    callback recapture-placement-requested();

    callback start-registration();
    callback cancel-registration();
    callback pick-folder-requested();
    callback pick-workspace-requested();
    callback refresh-candidates-requested();
    callback candidate-toggled(index: int);
    callback color-selected(color: color);
    callback fullscreen-toggled();
    callback parking-sub-selected(index: int);
    callback register-requested(name: string);

    callback empty-main-screen-requested();
    callback empty-candidate-toggled(index: int);
    callback confirm-empty-main-screen();
    callback cancel-empty-main-screen();
    callback undo-empty-main-screen();

    backdrop := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.glass-base;
        border-width: 1px;
        border-color: Theme.hairline-bright;
    }

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        if !root.registering: HorizontalLayout {
            spacing: Theme.space-sm;

            // Left: workset list
            GlassPanel {
                width: 300px;

                VerticalLayout {
                    padding: Theme.space-sm;
                    spacing: Theme.space-xs;

                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        SectionLabel { text: "登録済みセット"; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        GlassButton {
                            text: "更新";
                            clicked => { root.refresh-requested(); }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            for w[i] in root.worksets: Rectangle {
                                height: 72px;
                                background: root.selected-workset-index == i ? Theme.glass-selected : Theme.glass-panel-soft;
                                border-radius: Theme.radius-md;
                                border-width: 2px;
                                border-color: w.color;
                                animate background { duration: Theme.duration-fast; easing: ease-out; }

                                VerticalLayout {
                                    padding: Theme.space-xs;
                                    Text { text: w.name; font-size: 12px; font-weight: 700; color: Theme.text-primary; }
                                    Text { text: w.repository_path; font-size: 10px; color: Theme.text-tertiary; wrap: no-wrap; overflow: elide; }
                                    Text { text: w.parking_label; font-size: 10px; font-weight: 600; color: Theme.accent; }
                                    Text { text: w.status_label; font-size: 10px; color: Theme.text-secondary; }
                                }

                                TouchArea { clicked => { root.workset-selected(i); } }
                            }
                        }
                    }

                    GlassButton {
                        text: "+ 現在の配置をセットとして登録";
                        primary: true;
                        clicked => { root.start-registration(); }
                    }
                }
            }

            // Right: selected workset detail
            GlassPanel {
                horizontal-stretch: 1;

                VerticalLayout {
                    padding: Theme.space-sm;
                    spacing: Theme.space-xs;

                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        SectionLabel { text: "ウィンドウ一覧"; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        GlassButton {
                            text: root.selected-missing-count > 0
                                ? "閉じたアプリを開き直す (" + root.selected-missing-count + ")"
                                : "閉じたアプリを開き直す";
                            primary: root.selected-missing-count > 0;
                            enabled: root.selected-missing-count > 0;
                            clicked => { root.reopen-closed-requested(); }
                        }
                        GlassButton {
                            text: "配置を再登録";
                            enabled: root.selected-workset-index >= 0;
                            clicked => { root.recapture-placement-requested(); }
                        }
                        GlassButton {
                            text: "このセットを削除";
                            enabled: root.selected-workset-index >= 0;
                            clicked => { root.delete-workset-requested(); }
                        }
                    }

                    ScrollView {
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            for w[i] in root.selected-workset-windows: Rectangle {
                                height: 46px;
                                background: Theme.glass-panel-soft;
                                border-radius: Theme.radius-md;

                                HorizontalLayout {
                                    padding: Theme.space-xs;
                                    spacing: Theme.space-xs;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: w.title; font-size: 12px; color: Theme.text-primary; }
                                        Text {
                                            text: w.status_label;
                                            font-size: 10px;
                                            color: w.status_is_warning ? Theme.danger : Theme.success;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.registering: GlassPanel {
            VerticalLayout {
                padding: Theme.space-lg;
                spacing: Theme.space-sm;

                Text {
                    text: root.registration-editing ? "セットの配置を再登録" : "新しいワークセットを登録";
                    font-family: Theme.font-display;
                    font-size: 18px;
                    font-weight: 600;
                    letter-spacing: -0.2px;
                    color: Theme.text-primary;
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    GlassButton {
                        text: "フォルダーを選択（任意）";
                        clicked => { root.pick-folder-requested(); }
                    }
                    GlassButton {
                        text: "ワークスペースを選択";
                        clicked => { root.pick-workspace-requested(); }
                    }
                    Text { text: root.picked-folder-label; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                }
                Text { text: root.resolved-repo-label; font-size: 11px; color: Theme.text-tertiary; wrap: word-wrap; }

                SectionLabel { text: "名前"; }
                name-input := LineEdit {
                    placeholder-text: "ワークセット名";
                    text <=> root.registration-name;
                }

                SectionLabel { text: "色"; }
                HorizontalLayout {
                    spacing: Theme.space-xs;
                    for c in root.color-choices: Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: Theme.radius-pill;
                        background: c;
                        border-width: root.selected-color == c ? 3px : 0px;
                        border-color: Theme.text-primary;
                        animate border-width { duration: Theme.duration-fast; easing: ease-out; }
                        TouchArea { clicked => { root.color-selected(c); } }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    SectionLabel { text: "候補ウィンドウ（メイン画面上で検出）"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    GlassButton {
                        text: "候補を更新";
                        clicked => { root.refresh-candidates-requested(); }
                    }
                    GlassButton {
                        text: "メイン画面を空にする";
                        clicked => { root.empty-main-screen-requested(); }
                    }
                    GlassButton {
                        text: "元に戻す";
                        enabled: root.empty-undo-available;
                        clicked => { root.undo-empty-main-screen(); }
                    }
                }
                ScrollView {
                    height: 150px;
                    VerticalLayout {
                        spacing: 2px;
                        for candidate[i] in root.candidates: HorizontalLayout {
                            spacing: Theme.space-xs;
                            height: 26px;
                            GlassCheckbox {
                                checked: candidate.checked;
                                toggled => { root.candidate-toggled(i); }
                            }
                            Text {
                                text: candidate.title + "  (" + candidate.process_name + ")";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: "「閉じたアプリを開き直す」対象: VS Codeはフォルダー、ブラウザはURL（新規ウィンドウ）で復元します。その他のアプリは実行ファイルを再起動します（開いていた文書までは復元されません）。";
                    font-size: 10px;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    GlassCheckbox {
                        checked: root.fullscreen-when-parked;
                        toggled => { root.fullscreen-toggled(); }
                    }
                    Text {
                        text: "退避後に全画面表示にする（動画などを退避先モニターで最大化）";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    SectionLabel { text: "退避先"; vertical-alignment: center; }
                    GlassButton {
                        text: "自動";
                        primary: root.parking-selected-sub == -1;
                        clicked => { root.parking-sub-selected(-1); }
                    }
                    for name[i] in root.parking-subs: GlassButton {
                        text: name;
                        primary: root.parking-selected-sub == i;
                        clicked => { root.parking-sub-selected(i); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.parking-subs.length == 0: Text {
                    text: "サブ画面が未作成です。レイアウトスタジオで作成すると退避先に選べます。";
                    font-size: 10px;
                    color: Theme.text-tertiary;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Rectangle { horizontal-stretch: 1; }
                    GlassButton {
                        text: "キャンセル";
                        clicked => { root.cancel-registration(); }
                    }
                    GlassButton {
                        text: root.registration-editing ? "更新" : "登録";
                        primary: true;
                        clicked => { root.register-requested(name-input.text); }
                    }
                }
            }
        }

        StatusBanner {
            text: root.status-text;
            is-warning: root.status-is-warning;
        }
    }

    // --- "メイン画面を空にする" confirmation modal (moved from Layout Studio) ---
    if root.empty-screen-panel-visible: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: rgba(0, 0, 0, 0.55);

        TouchArea { }

        GlassPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: 360px;

            VerticalLayout {
                padding: Theme.space-md;
                spacing: Theme.space-sm;

                Text {
                    text: "メイン画面上の未登録ウィンドウ — 最小化するものにチェックしてください";
                    font-size: 13px;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }

                ScrollView {
                    VerticalLayout {
                        spacing: 2px;
                        for candidate[i] in root.main-screen-candidates: HorizontalLayout {
                            spacing: Theme.space-xs;
                            height: 26px;
                            GlassCheckbox {
                                checked: candidate.checked;
                                toggled => { root.empty-candidate-toggled(i); }
                            }
                            Text {
                                text: candidate.title + "  (" + candidate.process_name + ")";
                                font-size: 12px;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-xs;
                    Rectangle { horizontal-stretch: 1; }
                    GlassButton {
                        text: "キャンセル";
                        clicked => { root.cancel-empty-main-screen(); }
                    }
                    GlassButton {
                        text: "確定して最小化";
                        primary: true;
                        clicked => { root.confirm-empty-main-screen(); }
                    }
                }
            }
        }
    }
}
