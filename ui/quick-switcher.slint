import { ScrollView } from "std-widgets.slint";
import { GlassButton, Theme } from "theme.slint";

export struct QuickSwitcherRow {
    workset-id: string,
    name: string,
    repository-name: string,
    color: color,
    is-current: bool,
    is-parking-target: bool,
    number-hint: int,
    // Codex agent status (PLAN.md §6, Phase 8). `agent-status-label` is
    // empty for Idle/Unknown to avoid visual noise in the common case.
    agent-status-color: color,
    agent-status-label: string,
    agent-elapsed-text: string,
}

export component QuickSwitcher inherits Window {
    title: "RepoDeck — クイックスイッチャー";
    icon: @image-url("../assets/repodeck-icon.svg");
    no-frame: true;
    always-on-top: true;
    width: 480px;
    height: 560px;
    background: transparent;
    default-font-family: Theme.font-text;

    in property <[QuickSwitcherRow]> rows: [];
    in-out property <int> selected-index: 0;
    in property <string> filter-text: "";
    in property <string> status-text: "";
    in property <bool> status-is-warning: false;
    // True only while Windows' "Transparency effects" setting is on — see
    // `glass-base-translucent` in theme.slint for why this is gated.
    in property <bool> translucent: false;

    callback key-text-input(text: string);
    callback filter-backspace-requested();
    callback switch-requested(workset-id: string);
    callback recover-requested();
    callback settings-requested();
    callback close-requested();

    backdrop := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.translucent ? Theme.glass-base-translucent : Theme.glass-base;
        border-width: 1px;
        border-color: Theme.hairline-bright;
        border-radius: Theme.radius-lg;
    }

    forward-focus: key-handler;

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.selected-index = Math.max(0, root.selected-index - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.selected-index = Math.min(root.rows.length - 1, root.selected-index + 1);
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.rows.length > 0) {
                    root.switch-requested(root.rows[root.selected-index].workset-id);
                }
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.settings-requested();
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.filter-backspace-requested();
                return accept;
            }
            return root.key-jump-or-filter(event);
        }

        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-sm;

            HorizontalLayout {
                spacing: Theme.space-xs;
                height: 32px;
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: Theme.glass-panel-soft;
                    border-width: 1px;
                    border-color: Theme.hairline;

                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        alignment: start;
                        Text {
                            text: root.filter-text == "" ? "検索…" : root.filter-text;
                            color: root.filter-text == "" ? Theme.text-tertiary : Theme.text-primary;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                }

                close-button := Rectangle {
                    width: 32px;
                    border-radius: Theme.radius-md;
                    background: close-touch.pressed || close-touch.has-hover ? Theme.glass-hover : Theme.glass-panel-soft;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    animate background { duration: Theme.duration-fast; easing: ease-out; }

                    // Uses "×" (U+00D7), which Segoe UI Variable Text includes,
                    // rather than "✕" (U+2715) which the font lacks and renders as
                    // a tofu box.
                    Text {
                        text: "×";
                        color: Theme.text-secondary;
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        clicked => { root.close-requested(); }
                    }
                }
            }

            ScrollView {
                VerticalLayout {
                    spacing: Theme.space-xs;

                    for row[i] in root.rows: Rectangle {
                        height: 52px;
                        border-radius: Theme.radius-md;
                        background: i == root.selected-index ? Theme.glass-selected : Theme.glass-panel-soft;
                        border-width: row.is-current ? 2px : 1px;
                        border-color: row.is-current ? Theme.accent : Theme.hairline;
                        animate background, border-color { duration: Theme.duration-fast; easing: ease-out; }

                        HorizontalLayout {
                            padding: Theme.space-sm;
                            spacing: Theme.space-sm;

                            Rectangle {
                                width: 8px;
                                border-radius: 4px;
                                background: row.color;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: Theme.space-xs;
                                    Text {
                                        text: row.name;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                    }
                                    if row.is-current: Text {
                                        text: "現在";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: Theme.accent;
                                    }
                                    if row.is-parking-target: Text {
                                        text: "固定枠";
                                        font-size: 11px;
                                        color: Theme.text-tertiary;
                                    }
                                }
                                Text {
                                    text: row.repository-name;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                    overflow: elide;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if row.agent-status-label != "": HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: row.agent-status-color;
                                }
                                Text {
                                    text: row.agent-elapsed-text == "" ? row.agent-status-label : row.agent-status-label + " · " + row.agent-elapsed-text;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }

                            if row.number-hint > 0: Rectangle {
                                width: 20px;
                                height: 20px;
                                border-radius: 10px;
                                background: Theme.glass-panel-strong;
                                Text {
                                    text: row.number-hint;
                                    font-size: 11px;
                                    color: Theme.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.selected-index = i;
                                root.switch-requested(row.workset-id);
                            }
                        }
                    }
                }
            }

            if root.status-text != "": HorizontalLayout {
                spacing: Theme.space-xs;
                Text {
                    text: root.status-text;
                    font-size: 12px;
                    color: root.status-is-warning ? Theme.danger : Theme.text-tertiary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if root.status-is-warning: GlassButton {
                    text: "回収する";
                    clicked => { root.recover-requested(); }
                }
            }
        }
    }

    // Split out from `key-pressed` above: Slint's compiler blows its own
    // stack on a `key-pressed` body with too many sequential top-level `if`
    // statements (empirically confirmed around 12+ on this toolchain, filed
    // as a real compiler limitation rather than a bug in this code) — moving
    // the digit-jump/text-filter branch into its own `function` keeps each
    // individual callback/function body short enough to compile.
    function key-jump-or-filter(event: KeyEvent) -> EventResult {
        if (event.text == "1" && root.rows.length >= 1) { root.switch-requested(root.rows[0].workset-id); return accept; }
        if (event.text == "2" && root.rows.length >= 2) { root.switch-requested(root.rows[1].workset-id); return accept; }
        if (event.text == "3" && root.rows.length >= 3) { root.switch-requested(root.rows[2].workset-id); return accept; }
        if (event.text == "4" && root.rows.length >= 4) { root.switch-requested(root.rows[3].workset-id); return accept; }
        if (event.text == "5" && root.rows.length >= 5) { root.switch-requested(root.rows[4].workset-id); return accept; }
        return root.key-jump-or-filter-2(event);
    }

    function key-jump-or-filter-2(event: KeyEvent) -> EventResult {
        if (event.text == "6" && root.rows.length >= 6) { root.switch-requested(root.rows[5].workset-id); return accept; }
        if (event.text == "7" && root.rows.length >= 7) { root.switch-requested(root.rows[6].workset-id); return accept; }
        if (event.text == "8" && root.rows.length >= 8) { root.switch-requested(root.rows[7].workset-id); return accept; }
        if (event.text == "9" && root.rows.length >= 9) { root.switch-requested(root.rows[8].workset-id); return accept; }
        if (event.text.character-count == 1 && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
            root.key-text-input(event.text);
            return accept;
        }
        return reject;
    }
}
